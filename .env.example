# Copy to .env and fill in real values. .env is git-ignored; only this
# .example file (with placeholders) is committed.
#
# Every connection string here is host-agnostic: point it at the local
# docker-compose Postgres, a self-hosted box, or a managed provider — the app
# and migration tooling don't care. `sslmode` lives in the URL itself; local
# Docker uses `sslmode=disable` (or omits it), production MUST use
# `sslmode=verify-full` (see docs/security/security-design-principles.md §19,
# not `require`, which skips identity verification).

# App-runtime connection. Connects as the `moni_app` role, which is the only
# role subject to Row-Level Security (docs/security/threat-model.md §6). The
# domain layer sets `app.user_id` per request/transaction via
# `src/db/client.ts`'s `withUser()` — this role must never be able to read
# across users on its own.
DATABASE_URL=postgresql://moni_app:moni_app_dev_password@localhost:5432/moni

# Migration/DDL connection. Connects as the `moni_owner` role, which owns the
# tables and is exempt from the RLS policies it defines. Used only by
# `drizzle-kit generate`/`migrate` — never by the running app or worker.
# The `moni_owner` and `moni_app` roles themselves are bootstrapped by the
# Postgres superuser (docker-compose's default `postgres` user locally); role
# creation and RLS policy SQL are a later migration task, not this file.
DATABASE_URL_MIGRATE=postgresql://moni_owner:moni_owner_dev_password@localhost:5432/moni

# Base64-encoded 32-byte master key used ONLY by the dev seed script and
# local crypto tooling to derive per-user data keys.
# DEV ONLY — this is not a production key-custody path. Production key
# custody is per-user envelope encryption unlocked by a passkey/password, per
# docs/security/threat-model.md §5. Never reuse this value outside a local
# dev database, and never commit a real one here.
MONI_DEV_DATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
