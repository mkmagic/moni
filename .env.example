# Copy to .env and fill in real values. .env is git-ignored; only this
# .example file (with placeholders) is committed.
#
# Every connection string here is host-agnostic: point it at the local
# docker-compose Postgres, a self-hosted box, or a managed provider — the app
# and migration tooling don't care. `sslmode` lives in the URL itself; local
# Docker uses `sslmode=disable` (or omits it), production MUST use
# `sslmode=verify-full` (see docs/security/security-design-principles.md §19,
# not `require`, which skips identity verification).

# App-runtime connection. Connects as the `moni_app` role, which is the only
# role subject to Row-Level Security (docs/security/threat-model.md §6). The
# domain layer sets `app.user_id` per request/transaction via
# `src/db/client.ts`'s `withUser()` — this role must never be able to read
# across users on its own.
DATABASE_URL=postgresql://moni_app:moni_app_dev_password@localhost:5432/moni

# Migration/DDL connection. Connects as the `moni_owner` role, which owns the
# tables and is exempt from the RLS policies it defines. Used only by
# `drizzle-kit generate`/`migrate` — never by the running app or worker.
# The `moni_owner` and `moni_app` roles themselves are bootstrapped by the
# Postgres superuser (docker-compose's default `postgres` user locally); role
# creation and RLS policy SQL are a later migration task, not this file.
#
# BOOTSTRAP NOTE (drizzle/0001_rls_and_roles.sql): on a brand-new database
# `moni_owner` doesn't exist yet, so the value below can't be used for the
# very first `npm run db:migrate`. For that one run only, point this at the
# Docker superuser instead — `postgresql://postgres:postgres@localhost:5432/moni`
# — which creates both roles and hands the tables off to `moni_owner`. Once
# that's done, switch this back to the `moni_owner` URL below (the normal,
# steady-state value) for every subsequent migration. See the longer version
# of this note at the top of drizzle/0001_rls_and_roles.sql.
DATABASE_URL_MIGRATE=postgresql://moni_owner:moni_owner_dev_password@localhost:5432/moni

# Base64-encoded 32-byte master key used ONLY by pure dev/unit crypto tooling
# (src/lib/crypto/dev-key-provider.ts) — never wired into a real request
# path, and no longer used to seed real users (scripts/seed-demo.ts now goes
# through src/domain/registration.ts's createUser() instead).
# DEV ONLY — this is not a production key-custody path. Production key
# custody is per-user envelope encryption unlocked by a passkey/password, per
# docs/security/threat-model.md §5. Never reuse this value outside a local
# dev database, and never commit a real one here.
MONI_DEV_DATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Shared invite token the owner hands to family members so they can sign up
# (docs/security/threat-model.md §1 — accounts are owner-issued, not
# self-served on the open internet). Required by src/domain/registration.ts's
# createUser(); unset/empty is treated as a rejection, never as "open
# signup". Also required to run `npm run seed:demo`, which calls createUser()
# for its demo users. Pick a real random value for any reachable deployment.
MONI_SIGNUP_TOKEN=change-me-dev-signup-token

# Optional path to a local Chrome/Chromium binary, passed as `executablePath`
# to Puppeteer (scripts/scrape-worker.mts) — needed on macOS/arm64 when
# `npx puppeteer browsers install chrome` doesn't produce a binary Puppeteer
# can launch on its own (.agents/skills/israeli-scraper/SKILL.md's
# troubleshooting note). Leave unset to use Puppeteer's bundled Chromium.
# MONI_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional .png FILE path. When set, the scraper snapshots the page at the
# moment a scrape fails (scripts/scrape-worker.mts) — the only way to see
# which page a headless run actually died on, since the error text names a
# timeout but never a step. Unset in normal operation. Pair it with
# DEBUG='israeli-bank-scrapers:*' to get the library's own step logging.
# MONI_SCRAPE_FAILURE_SCREENSHOT=/tmp/moni-scrape-failure.png

# Set to "true" to run the scrape with a VISIBLE browser window instead of
# headless — for debugging a stuck login by watching it.
# MONI_SCRAPE_SHOW_BROWSER=true
