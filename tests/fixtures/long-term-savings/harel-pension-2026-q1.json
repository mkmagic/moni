  { "text": "שנעשו בפועל", "x": 40.1, "right": 92.2, "y": 168.6, "centre": 66.1, "page": 1 },
  { "text": "כדאי להיעזר", "x": 43.8, "right": 92.1, "y": 158.5, "centre": 68, "page": 1 },
