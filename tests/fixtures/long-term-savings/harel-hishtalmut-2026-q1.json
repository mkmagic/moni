  { "text": "שההפקדות", "x": 47.2, "right": 92.2, "y": 293.8, "centre": 69.7, "page": 1 },
  { "text": "בדוח תואמות", "x": 39.7, "right": 92.2, "y": 283.1, "centre": 66, "page": 1 },
  { "text": "את ההפקדות", "x": 39.5, "right": 92.2, "y": 272.4, "centre": 65.8, "page": 1 },
